# ─── Required for streaming providers ───────────────────────────────────
# Without this, Cloudflare-protected anime sites (anikoto, anizone, etc.)
# will return 403 from datacenter IPs (Vercel, AWS, etc.).
# Use a residential proxy service (e.g., ScraperAPI, Bright Data, Smartproxy).
SCRAPE_PROXY_URL=
SCRAPE_PROXY_KEY=

# ─── Optional: OpenSubtitles ───────────────────────────────────────────
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
